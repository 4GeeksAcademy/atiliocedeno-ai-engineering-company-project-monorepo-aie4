# Copy to services/healthcore-api/.env and replace the placeholder locally.
HEALTHCORE_JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_LOCAL_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=30
HEALTHCORE_FRONTEND_URL=http://localhost:3000
# Optional; leave empty to disable email and automatic admin creation.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
HEALTHCORE_BOOTSTRAP_ADMIN_EMAIL=
HEALTHCORE_BOOTSTRAP_ADMIN_PASSWORD=
# Optional absolute path; default is service/data/healthcore.json.
# HEALTHCORE_DB_PATH=/absolute/path/to/healthcore.json
